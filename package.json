{
  "name": "mamgorithm",
  "version": "1.0.0",
  "description": "내맘대로 알고리즘 (맘고리즘) - 반응형 웹 프로젝트",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "start": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "test:intro": "node tests/intro.integration.cjs",
    "test:feed": "node --test tests/feed-engine.test.mjs",
    "test:feed:browser": "node tests/feed.browser.cjs",
    "test:content": "node --test tests/content-admin.test.mjs",
    "test:content:browser": "node tests/content-admin.browser.cjs",
    "studio": "node tools/studio-server.mjs",
    "test:studio": "node --test tests/studio.test.mjs",
    "test:studio:browser": "node tests/studio.browser.cjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "firebase": "^13.1.0"
  }
}
