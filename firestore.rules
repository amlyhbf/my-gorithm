// Prototype rules for users/{uid}: private interest weights and update time.
// weights: exactly study, tech, culture, hobby; integer values from 0 to 100.
// updatedAt: timestamp. Other collections remain inaccessible to clients.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function isWeight(value) {
      return value is int && value >= 0 && value <= 100;
    }
    function isValidUser(data) {
      return data.keys().hasAll(['weights', 'updatedAt'])
        && data.keys().hasOnly(['weights', 'updatedAt'])
        && data.weights is map
        && data.weights.keys().hasAll(['study', 'tech', 'culture', 'hobby'])
        && data.weights.keys().hasOnly(['study', 'tech', 'culture', 'hobby'])
        && isWeight(data.weights.study) && isWeight(data.weights.tech)
        && isWeight(data.weights.culture) && isWeight(data.weights.hobby)
        && data.updatedAt is timestamp;
    }
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
